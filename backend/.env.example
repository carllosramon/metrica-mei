# SQLite no desenvolvimento e nos testes.
DATABASE_URL=sqlite:///./data/metrica_mei.db

# PostgreSQL em produção: troque a variável acima por esta e rode
# alembic upgrade head. Nenhuma regra de negócio precisa mudar.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/metricamei

JWT_SECRET=replace-with-a-local-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
