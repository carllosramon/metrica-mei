# SQLite no desenvolvimento e nos testes.
DATABASE_URL=sqlite:///./data/metrica_mei.db

# PostgreSQL em produção: troque a variável acima por esta e rode
# alembic upgrade head. Nenhuma regra de negócio precisa mudar.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/metricamei

# Assina todo token, e precisa ter ao menos 32 caracteres. Fica vazia de
# propósito: um valor de exemplo é um valor que alguém copia sem trocar,
# e aí quem leu o repositório sabe assinar token como qualquer usuário.
# Vazia, a API recusa subir e diz por quê. Gere o seu com:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
